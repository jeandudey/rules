[cells]
  root = .
  prelude = prelude
  rules = rules
  toolchains = toolchains
  none = none

[cell_aliases]
  examples = root
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[external_cells]
  prelude = bundled
  rules = git

[external_cell_rules]
  git_origin = https://github.com/jeandudey/rules.git
  commit_hash = cb14e7fbcd19e640fd4eb8df597275b83eac01b2

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:rules//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default

[build]
  execution_platforms = prelude//platforms:default
